                echo 'Building Application'
            }
        }

        stage('Test') {
            steps {
                echo 'Running Tests'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying Application'
            }
        }
        stage('Release') {
            steps {
                echo 'Releasing Application'
            }
        }
    }
}
